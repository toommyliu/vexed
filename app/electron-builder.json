{
  "appId": "com.app.vexed",
  "productName": "Vexed",
  "electronVersion": "11.5.0",
  "npmRebuild": false,
  "directories": {
    "output": "build"
  },
  "files": ["dist/**/*", "package.json", "!node_modules/**/*"],
  "mac": {
    "extraResources": [
      {
        "from": "../assets",
        "to": "assets",
        "filter": ["**/*", "!pepflashplayer.dll"]
      }
    ],
    "asar": false,
    "target": {
      "target": "zip",
      "arch": ["x64"]
    },
    "icon": "../assets/icon.png",
    "artifactName": "${productName}-${os}.${ext}"
  },
  "win": {
    "extraResources": [
      {
        "from": "../assets",
        "to": "assets",
        "filter": ["**/*", "!PepperFlashPlayer.plugin"]
      }
    ],
    "icon": "../assets/icon.ico",
    "asar": false,
    "target": {
      "target": "zip",
      "arch": ["x64"]
    },
    "artifactName": "${productName}-${os}.${ext}"
  },
  "linux": {
    "extraResources": [
      {
        "from": "../assets",
        "to": "assets",
        "filter": ["**/*", "!PepperFlashPlayer.plugin", "!pepflashplayer.dll"]
      }
    ],
    "asar": false,
    "target": {
      "target": "zip",
      "arch": ["x64"]
    },
    "icon": "../assets/icon.png",
    "artifactName": "${productName}-${os}.${ext}"
  },
  "extraMetadata": {
    "name": "vexed",
    "main": "./dist/main/index.js"
  }
}
